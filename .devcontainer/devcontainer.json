{
    "name": "latexbuild",
    "build": {
        "dockerfile": "../docker/Dockerfile",
        "context": "../docker"
    },
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "James-Yu.latex-workshop"
            ],
            "settings": {
                "latex-workshop.view.pdf.viewer": "tab",
                "latex-workshop.latex.autoBuild.run": "onSave"
            }
        }
    }
}
