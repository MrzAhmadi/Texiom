#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
DOCKER_DIR="$SCRIPT_DIR/docker"
# shellcheck source=docker/config.sh
source "$DOCKER_DIR/config.sh"
VERSION="$(cat "$SCRIPT_DIR/VERSION" 2>/dev/null || echo "unknown")"
IMAGE_TAG="texiom"
FORCE_REBUILD=0
NO_PULL=0
REGISTRY_IMAGE="ghcr.io/mrzahmadi/texiom:latest"
PDF_ONLY=0
ENGINE=""
WATCH=0
SHELL_ESCAPE=0
EDIT_MODE=0
EDIT_PORT=8765
EDIT_VOLUME="texiom-workspace"
KILL_EDIT=0
TEX_DIR=""
TEX_FILE=""
APT_PKGS=""
PIP_PKGS=""

bind 'set show-all-if-ambiguous on' 2>/dev/null || true
bind 'set page-completions off' 2>/dev/null || true

usage() {
    cat <<'USAGE'
Usage:
  texiom                              interactive prompts
  texiom -d DIR -f FILE.tex           non-interactive
  texiom --edit                       open the browser editor - your
                                       project lives entirely inside a
                                       persistent Docker volume, managed
                                       from the browser (create/upload/
                                       rename/delete files and folders);
                                       -d/-f are not used with --edit
  texiom -d DIR -f FILE.tex --rebuild force a fresh image build
  texiom -d DIR -f FILE.tex --no-pull build the image locally, never download it
  texiom -d DIR -f FILE.tex --pdf-only
  texiom -d DIR -f FILE.tex --engine xelatex
  texiom -d DIR -f FILE.tex --watch

Options:
  -d, --dir DIR       Directory containing the .tex file (not used with --edit)
  -f, --file FILE     Name of the .tex file, extension optional (not used
                       with --edit); auto-detected if the directory has
                       exactly one .tex file
  -t, --tag TAG       Docker image tag to use/build (default: texiom)
  -r, --rebuild       Force rebuild of the Docker image even if it exists
      --no-pull       Never download the prebuilt image from GHCR; build locally
  -E, --engine ENGINE LaTeX engine: pdflatex (default), xelatex or lualatex
                       (not used with --edit)
      --apt PKGS      Install extra apt packages (comma-separated, repeatable)
      --pip PKGS      Install extra pip packages (comma-separated, repeatable)
      --shell-escape  Allow LaTeX to run external programs (needed by minted)
  -p, --pdf-only      Remove latexmk's auxiliary files after a successful
                       build, leaving only the .pdf next to the .tex source
  -w, --watch         Rebuild automatically whenever the .tex file (or
                       anything it includes) changes; Ctrl+C to stop
  -e, --edit          Open the browser-based editor (source left, PDF right)
                       for your persistent in-container project; Ctrl+C to stop
  -k, --kill-edit     Stop any running --edit session (frees its port) and exit
  -v, --version       Show the installed version
  -h, --help          Show this help message

A texiom.toml next to the .tex file can set file, engine, pdf_only, watch,
shell_escape, apt and pip (lists);
command-line flags override it.
USAGE
    exit 0
}

# Extra packages (--apt / --pip / texiom.toml): a tiny layer on top of the
# base image, tagged by the base hash + package lists so it is built once.
build_extras_image() {
    local apt pip spec
    apt="$(echo $APT_PKGS)"; pip="$(echo $PIP_PKGS)"
    [[ -n "$apt$pip" ]] || return 0
    validate_packages $apt $pip
    spec="$(printf '%s|%s|%s' "$(docker image inspect --format '{{.Id}}' "$IMAGE_TAG")" "$apt" "$pip" | sha256sum | cut -c1-12)"
    local extras_tag="${IMAGE_TAG%%:*}-extras:$spec"
    if ! docker image inspect "$extras_tag" >/dev/null 2>&1; then
        echo "Building image with extra packages (apt: ${apt:-none}; pip: ${pip:-none}) ..."
        {
            echo "FROM $IMAGE_TAG"
            [[ -z "$apt" ]] || echo "RUN apt-get update && apt-get install -y $apt && rm -rf /var/lib/apt/lists/*"
            [[ -z "$pip" ]] || echo "RUN pip3 install --break-system-packages --no-cache-dir $pip"
        } | docker build -t "$extras_tag" -
    fi
    IMAGE_TAG="$extras_tag"
}

set_engine() {
    ENGINE="${ENGINE:-pdflatex}"
    case "$ENGINE" in
        pdflatex) LATEXMK_ENGINE="-pdf" ;;
        xelatex)  LATEXMK_ENGINE="-xelatex" ;;
        lualatex) LATEXMK_ENGINE="-lualatex" ;;
        *) echo "Error: unknown engine '$ENGINE' (use pdflatex, xelatex or lualatex)." >&2; exit 1 ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)      TEX_DIR="$2"; shift 2 ;;
        -f|--file)     TEX_FILE="$2"; shift 2 ;;
        -t|--tag)      IMAGE_TAG="$2"; shift 2 ;;
        -r|--rebuild)  FORCE_REBUILD=1; shift ;;
        --no-pull)     NO_PULL=1; shift ;;
        -E|--engine)   ENGINE="$2"; shift 2 ;;
        --apt)         APT_PKGS+=" ${2//,/ }"; shift 2 ;;
        --pip)         PIP_PKGS+=" ${2//,/ }"; shift 2 ;;
        --shell-escape) SHELL_ESCAPE=1; shift ;;
        -p|--pdf-only) PDF_ONLY=1; shift ;;
        -w|--watch)    WATCH=1; shift ;;
        -e|--edit)     EDIT_MODE=1; shift ;;
        -k|--kill-edit) KILL_EDIT=1; shift ;;
        -v|--version)  echo "texiom $VERSION"; exit 0 ;;
        -h|--help)     usage ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

if [[ "$KILL_EDIT" -eq 1 ]]; then
    CONTAINERS="$(docker ps --filter "publish=$EDIT_PORT" --format '{{.ID}} {{.Names}} {{.Image}}')"
    if [[ -z "$CONTAINERS" ]]; then
        echo "No session found on port $EDIT_PORT."
        exit 0
    fi
    echo "Stopping session(s) on port $EDIT_PORT:"
    echo "$CONTAINERS"
    docker stop $(echo "$CONTAINERS" | cut -d' ' -f1) >/dev/null
    echo "Done."
    exit 0
fi

# Relative paths + C-locale sort so the hash matches the one CI bakes into the GHCR image.
DOCKER_HASH="$(cd "$DOCKER_DIR/.." && find docker -type f -not -path 'docker/editor/*' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -d' ' -f1)"
IMAGE_HASH="$(docker image inspect --format '{{ index .Config.Labels "texiom.dockerhash" }}' "$IMAGE_TAG" 2>/dev/null || true)"

# Read the build hash baked into the prebuilt image without downloading it
# (a few KB instead of ~2.7 GB). Prints nothing if anything goes wrong, in
# which case we fall back to pulling and comparing.
remote_image_hash() {
    command -v curl >/dev/null 2>&1 || return 0
    local repo="${REGISTRY_IMAGE#ghcr.io/}"; repo="${repo%%:*}"
    local tag="${REGISTRY_IMAGE##*:}"
    local token manifest digest
    token="$(curl -fsS --max-time 15 "https://ghcr.io/token?scope=repository:${repo}:pull" 2>/dev/null \
        | grep -o '"token":"[^"]*"' | head -1 | cut -d'"' -f4)" || return 0
    [[ -n "$token" ]] || return 0
    manifest="$(curl -fsS --max-time 15 -H "Authorization: Bearer $token" \
        -H "Accept: application/vnd.docker.distribution.manifest.v2+json, application/vnd.oci.image.manifest.v1+json" \
        "https://ghcr.io/v2/${repo}/manifests/${tag}" 2>/dev/null)" || return 0
    digest="$(printf '%s' "$manifest" | tr -d '\n ' | grep -o '"config":{[^}]*"digest":"sha256:[0-9a-f]*"' | grep -o 'sha256:[0-9a-f]*')" || return 0
    [[ -n "$digest" ]] || return 0
    curl -fsSL --max-time 15 -H "Authorization: Bearer $token" \
        "https://ghcr.io/v2/${repo}/blobs/${digest}" 2>/dev/null \
        | grep -o '"texiom.dockerhash":"[0-9a-f]*"' | head -1 | cut -d'"' -f4 || true
}

REMOTE_HASH=""
if [[ "$FORCE_REBUILD" -eq 0 ]] && [[ "$NO_PULL" -eq 0 ]] && [[ "$IMAGE_HASH" != "$DOCKER_HASH" ]]; then
    REMOTE_HASH="$(remote_image_hash)"
fi

if [[ "$FORCE_REBUILD" -eq 0 ]] && [[ "$NO_PULL" -eq 0 ]] && [[ "$IMAGE_HASH" != "$DOCKER_HASH" ]] \
        && [[ -n "$REMOTE_HASH" ]] && [[ "$REMOTE_HASH" != "$DOCKER_HASH" ]]; then
    echo "Prebuilt image is for a different version than this install; building locally."
elif [[ "$FORCE_REBUILD" -eq 0 ]] && [[ "$NO_PULL" -eq 0 ]] && [[ "$IMAGE_HASH" != "$DOCKER_HASH" ]]; then
    echo "Trying prebuilt image $REGISTRY_IMAGE ..."
    if docker pull "$REGISTRY_IMAGE" >/dev/null 2>&1; then
        PULLED_HASH="$(docker image inspect --format '{{ index .Config.Labels "texiom.dockerhash" }}' "$REGISTRY_IMAGE" 2>/dev/null || true)"
        if [[ "$PULLED_HASH" == "$DOCKER_HASH" ]]; then
            docker tag "$REGISTRY_IMAGE" "$IMAGE_TAG"
            IMAGE_HASH="$PULLED_HASH"
            echo "Using prebuilt image (matches this version)."
        else
            echo "Prebuilt image does not match this version; building locally."
        fi
    else
        echo "Prebuilt image unavailable; building locally."
    fi
fi

if [[ "$FORCE_REBUILD" -eq 1 ]] || [[ "$IMAGE_HASH" != "$DOCKER_HASH" ]]; then
    echo "Building image '$IMAGE_TAG' from $DOCKER_DIR (build inputs changed) ..."
    docker build \
        --build-arg "TEXIOM_VERSION=$VERSION" \
        --build-arg "TEXIOM_DOCKER_HASH=$DOCKER_HASH" \
        -t "$IMAGE_TAG" -f "$DOCKER_DIR/Dockerfile" "$DOCKER_DIR"
else
    echo "Using existing image '$IMAGE_TAG' (build inputs unchanged)."
fi

if [[ "$EDIT_MODE" -eq 1 ]]; then
    docker volume create "$EDIT_VOLUME" >/dev/null
    echo "Starting live editor (project: Docker volume '$EDIT_VOLUME') at http://127.0.0.1:$EDIT_PORT (Ctrl+C to stop) ..."
    docker run --rm -p "127.0.0.1:$EDIT_PORT:8000" \
        -v "$EDIT_VOLUME":/workspace -w /workspace \
        -v "$DOCKER_DIR/editor":/opt/texiom-editor:ro \
        "$IMAGE_TAG" python3 /opt/texiom-editor/server.py &
    DOCKER_PID=$!
    trap 'kill "$DOCKER_PID" 2>/dev/null || true' INT TERM
    ( sleep 1
      if kill -0 "$DOCKER_PID" 2>/dev/null; then
          xdg-open "http://127.0.0.1:$EDIT_PORT" >/dev/null 2>&1 || open "http://127.0.0.1:$EDIT_PORT" >/dev/null 2>&1 || true
      fi
    ) &
    wait "$DOCKER_PID"
    exit $?
fi

if [[ -z "$TEX_DIR" ]]; then
    if [[ -z "$TEX_FILE" ]]; then
        read -e -rp "Path to the .tex file (or its directory): " TEX_DIR
    else
        read -e -rp "Directory containing the .tex file: " TEX_DIR
    fi
fi
TEX_DIR="${TEX_DIR/#\~/$HOME}"

if [[ -z "$TEX_FILE" && ! -d "$TEX_DIR" ]]; then
    TEX_FILE="$(basename -- "$TEX_DIR")"
    TEX_DIR="$(dirname -- "$TEX_DIR")"
fi

if [[ ! -d "$TEX_DIR" ]]; then
    echo "Error: directory '$TEX_DIR' does not exist." >&2
    exit 1
fi
TEX_DIR="$(cd "$TEX_DIR" && pwd)"
cd "$TEX_DIR"
load_config "$TEX_DIR"
set_engine
SHELL_ESCAPE_OPT=""
[[ "$SHELL_ESCAPE" -eq 0 ]] || SHELL_ESCAPE_OPT="-shell-escape"
build_extras_image

if [[ -z "$TEX_FILE" ]]; then
    mapfile -t TEX_CANDIDATES < <(find "$TEX_DIR" -maxdepth 1 -name '*.tex' | sort)
    if [[ ${#TEX_CANDIDATES[@]} -eq 1 ]]; then
        TEX_FILE="$(basename -- "${TEX_CANDIDATES[0]}")"
    else
        read -e -rp "Name of the .tex file (e.g. paper.tex): " TEX_FILE
    fi
fi

[[ "$TEX_FILE" == *.tex ]] || TEX_FILE="${TEX_FILE}.tex"
if [[ ! -f "$TEX_DIR/$TEX_FILE" ]]; then
    echo "Error: '$TEX_DIR/$TEX_FILE' not found." >&2
    exit 1
fi

if [[ "$WATCH" -eq 1 ]]; then
    echo "Watching '$TEX_FILE' in '$TEX_DIR' - rebuilding on every change (Ctrl+C to stop) ..."
    docker run --rm -v "$TEX_DIR":/workspace -w /workspace "$IMAGE_TAG" \
        latexmk -pvc -view=none $LATEXMK_ENGINE $SHELL_ESCAPE_OPT -interaction=nonstopmode -halt-on-error "$TEX_FILE" || true
else
    echo "Compiling '$TEX_FILE' in '$TEX_DIR' with $ENGINE ..."
    docker run --rm -v "$TEX_DIR":/workspace -w /workspace "$IMAGE_TAG" \
        latexmk $LATEXMK_ENGINE $SHELL_ESCAPE_OPT -interaction=nonstopmode -halt-on-error "$TEX_FILE"
fi

PDF_FILE="${TEX_FILE%.tex}.pdf"
if [[ -f "$TEX_DIR/$PDF_FILE" ]]; then
    echo "Done: $TEX_DIR/$PDF_FILE"
else
    echo "Build finished but '$PDF_FILE' was not found - check the log above." >&2
    exit 1
fi

if [[ "$PDF_ONLY" -eq 1 ]]; then
    BASE_NAME="${TEX_FILE%.tex}"
    for ext in aux log out toc lof lot fls fdb_latexmk synctex.gz bbl blg bcf run.xml nav snm vrb xdv; do
        rm -f "$TEX_DIR/$BASE_NAME.$ext"
    done
    echo "Removed auxiliary build files; only '$PDF_FILE' remains."
fi
